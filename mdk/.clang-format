# 基础风格
BasedOnStyle: LLVM

# 缩进与换行 (4空格)
UseTab: Never
IndentWidth: 4
TabWidth: 4
ContinuationIndentWidth: 4
ColumnLimit: 80

# 括号不换行风格 (Attach)
BreakBeforeBraces: Attach

# --- 核心修复：宏定义全局强行对齐 ---
# 使用结构化写法，强行跨越空行和注释进行全局对齐
AlignConsecutiveMacros:
  Enabled: true
  AcrossEmptyLines: true
  AcrossComments: true